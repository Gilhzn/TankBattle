{
  "name": "tank-1990-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @tank/shared && npm run build -w @tank/server && npm run build -w @tank/client",
    "start": "node packages/server/dist/index.js",
    "typecheck": "tsc -b packages/shared packages/server packages/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
